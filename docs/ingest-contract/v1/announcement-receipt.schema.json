{
  "$defs": {
    "AnnouncementState": {
      "description": "Where an announcement stands.",
      "oneOf": [
        {
          "const": "pending",
          "description": "Shown dashed in the atlas, waiting for the operator's answer.",
          "type": "string"
        },
        {
          "const": "activated",
          "description": "Activated: the poll carries the producer key and first epoch once.",
          "type": "string"
        },
        {
          "const": "rejected",
          "description": "The operator declined it.",
          "type": "string"
        },
        {
          "const": "revoked",
          "description": "The operator cut this device off: its key no longer opens the door,\nand one it never fetched is never handed over. Terminal: stop polling\nand stop sending; only a new announcement the operator lets in again\npairs this install anew.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "A state this contract version does not know. Keep polling.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The reply to an announcement.",
  "properties": {
    "announcement": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/AnnouncementState"
    }
  },
  "required": [
    "announcement",
    "profile",
    "state"
  ],
  "title": "AnnouncementReceipt",
  "type": "object"
}
