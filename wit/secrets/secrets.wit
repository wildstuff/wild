// WILD Secrets Interface
//
// Host-mediated named-secret access for components. Components
// read user-managed secrets through this interface — they MUST
// NOT hardcode keys, read env vars directly, or open files.
//
// Phase 6 of `wild/docs/secrets.md`. The immediate consumer is
// Phase 7 (Tier-2 OCI 3rd-party adapters) — without a host-side
// secrets surface there is no safe way to ship a 3rd-party
// adapter that needs an API key.
//
// Trust model:
//
//   1. Component declares which secret aliases it wants in its
//      install config (`<profile_root>/llm-adapters.yaml` for adapters,
//      `<profile_root>/plugins/<id>.json` for installed plugins).
//   2. User runs `wild secret grant <component-id> <name>` to
//      authorize each one. ACL persists in
//      `<profile_root>/system/secret-grants.json`.
//   3. Component calls `secrets/store::get(alias)`. The host
//      resolves alias → keychain-name through the install
//      config, then ACL-checks, then dispatches to the
//      `SecretsBackend` chain (keychain → file → env), then
//      publishes an audit event on
//      `wild.{org}.system.secrets.access`.
//   4. Component receives the value as a transient string. It
//      MUST NOT cache the value across calls — rotation works
//      only because every read hits the host.
//
// Read-only by design:
//
//   `get` is the only operation. There is no `list`, `set`, or
//   `delete` from the component side. Listing names would leak
//   the user's keychain shape; writes go exclusively through
//   the `wild secret` CLI. This is the point of having a
//   secrets plugin — narrow surface, strong audit.
//
// Backend choice:
//
//   The component sees one logical surface. The host decides
//   which backend (OS keychain, encrypted file, env-passthrough)
//   actually answers each `get` via the chained resolver
//   defined in `wild/docs/secrets.md`. A misconfigured chain is
//   the user's problem, not the component's — the component
//   either gets the value or one of the typed error variants.

package wild:secrets@0.1.0;

interface store {

    /// Read a named secret.
    ///
    /// `name` is the COMPONENT-SIDE alias (e.g. `"api-key"`,
    /// `"slack-token"`) that the component's source code
    /// references. The host resolves the alias to the user's
    /// chosen keychain entry name through the install-config
    /// alias map, then runs the ACL check, then walks the
    /// backend chain.
    ///
    /// Returns the value as a string on success. The component
    /// MUST treat the value as transient — caching it across
    /// `get` calls breaks rotation semantics (the user expects
    /// `wild secret rotate` to take effect on the next read).
    ///
    /// On failure the typed `secret-error` discriminates the
    /// case so the component can react sensibly:
    /// `not-found` → tell the user how to add the secret;
    /// `access-denied` → tell the user how to grant it;
    /// `backend-unavailable` → propagate the cause as a
    /// transient infra error (locked keychain, broken D-Bus).
    get: func(name: string) -> result<string, secret-error>;

    variant secret-error {
        /// The aliased keychain entry doesn't exist in any of
        /// the configured backends. Either the user removed it
        /// via `wild secret remove`, or never ran
        /// `wild secret add` for that name in the first place.
        not-found,

        /// The component asked for an alias that isn't granted
        /// to it in `<profile_root>/system/secret-grants.json`. The host logs
        /// a security event before this error returns; the
        /// component can surface a helpful error to the user
        /// pointing at `wild secret grant`.
        access-denied,

        /// The backend chain itself failed in a way that aborts
        /// the request: master keychain locked, D-Bus daemon
        /// down, decrypt-error on the encrypted-file backend.
        /// Carries the raw cause string for the component to
        /// log. Distinct from `not-found` so the component can
        /// distinguish "config issue" from "infra hiccup".
        backend-unavailable(string),
    }
}

/// `secrets-host` — the single world a component imports to use
/// the secrets surface. Mirrors the `*-host` shape of every
/// other wild plugin world.
world secrets-host {
    import store;
}
